    <string name="jump_in_rule">Jump-in rule</string>
    <string name="uno_advanced_description_2">If you have the exact same card as the top card, you can play it instantly out of turn. Play continues from you.</string>
    <string name="seven_o_rule">Seven-O rule</string>
    <string name="uno_advanced_description_3">Playing a 7 lets you swap hands with another player. Playing a 0 makes everyone pass their hand in the current direction.</string>

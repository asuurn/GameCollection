<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".paranoia.ParanoiaActivity">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonToCroatianPick"
        android:layout_width="172dp"
        android:layout_height="78dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/card_game_button"
        android:fontFamily="serif"
        android:text="Croatian pick"
        android:textColor="@color/cardGameButtonTextColour"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonToUno" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonToUno"
        android:layout_width="172dp"
        android:layout_height="78dp"
        android:background="@drawable/card_game_button"
        android:fontFamily="serif"
        android:text="Uno"
        android:textColor="@color/cardGameButtonTextColour"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/buttonToCroatianPick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonToPoker" />

    <TextView
        android:id="@+id/CroatianPickTextView"
        android:layout_width="356dp"
        android:layout_height="101dp"
        android:fontFamily="serif"
        android:text="Assortment of card games"
        android:textAlignment="center"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/buttonToBaila"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonToBaila"
        android:layout_width="172dp"
        android:layout_height="78dp"
        android:background="@drawable/card_game_button"
        android:fontFamily="serif"
        android:text="Baila"
        android:textColor="@color/cardGameButtonTextColour"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/buttonToPoker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/CroatianPickTextView" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonToPoker"
        android:layout_width="172dp"
        android:layout_height="78dp"
        android:background="@drawable/card_game_button"
        android:fontFamily="serif"
        android:text="Poker"
        android:textColor="@color/cardGameButtonTextColour"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/buttonToUno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonToBaila" />

    <TextView
        android:id="@+id/CardsNotIncluded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="serif"
        android:text="Cards not included"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/CroatianPickTextView" />

    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:padding="8dp"
        android:src="@drawable/arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
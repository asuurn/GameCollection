<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/newGameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New Game"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/newGameMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="What would you like to do?"
        android:textSize="17sp"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/newGameMessage2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="New game will erase existing players and history"
        android:textSize="17sp"
        android:textColor="?android:attr/textColorSecondary" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonNewGame"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/card_game_button"
        android:fontFamily="serif"
        android:text="New game"
        android:textColor="@color/cardGameButtonTextColour"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonSamePlayers"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_game_button"
        android:fontFamily="serif"
        android:text="Same players"
        android:textColor="@color/cardGameButtonTextColour"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:fontFamily="serif"
        android:text="Cancel"
        android:textColor="@color/cardGameButtonTextColour"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
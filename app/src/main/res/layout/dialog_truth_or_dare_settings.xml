<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/game_settings"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/addQuestionsTextview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/enable_extra_questions_by_type"
        android:textSize="17sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/workplaceSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/work_workplace"
        android:textSize="20sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/relationshipSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/relationship"
        android:textSize="20sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sexualSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/spicy_sexual"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/savePreferencesTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/your_preferences_will_be_saved"
        android:textSize="17sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonBack"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="40dp"
        android:paddingVertical="16dp"
        android:layout_gravity="center"
        android:background="@drawable/truth_or_dare_button"
        android:text="@string/back"
        android:textColor="@color/truthOrDareButtonTextColour"
        android:textSize="20sp" />

</LinearLayout>
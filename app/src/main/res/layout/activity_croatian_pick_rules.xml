<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".cardgames.croatianPick.CroatianPickRules">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="8dp"
                android:src="@drawable/arrow_back" />

            <TextView
                android:id="@+id/textViewCroatianPickRuleTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/croatian_pick"
                android:textSize="30sp"
                 />

            <Space
                android:layout_width="40dp"
                android:layout_height="40dp"/>

        </LinearLayout>

        <!-- Setup -->
        <TextView
            android:id="@+id/textViewSetupHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/setup"
            android:textSize="20sp"
             />

        <TextView
            android:id="@+id/textViewSetupBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:padding="14dp"
            android:text="@string/croatian_pick_description_1"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <!-- Turn -->
        <TextView
            android:id="@+id/textViewTurnHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/on_your_turn"
            android:textSize="20sp"
             />

        <TextView
            android:id="@+id/textViewTurnBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:padding="14dp"
            android:text="@string/croatian_pick_description_2"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <!-- Scoring -->
        <TextView
            android:id="@+id/textViewScoringHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/scoring"
            android:textSize="20sp"
             />

        <TextView
            android:id="@+id/textViewScoringBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:padding="14dp"
            android:text="@string/croatian_pick_description_3"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <!-- Winning / Losing -->
        <TextView
            android:id="@+id/textViewWinningHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/winning_losing"
            android:textSize="20sp"
             />

        <TextView
            android:id="@+id/textViewWinningBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:padding="14dp"
            android:text="@string/croatian_pick_description_4"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>